# Copy this file to ".env" and fill in your key:
#     cp .env.example .env
# then edit .env

# Your Google AI Studio (Gemini) API key
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults are fine to start):
# GEMINI_MODEL=gemini-3.6-flash
# EMBEDDING_BACKEND=sentence-transformers
# N_CLUSTERS=6

# Self-audit tab (uploading the brand's own videos). The clip is sent
# straight to Gemini, so this uses a multimodal model + a longer timeout.
# GEMINI_VIDEO_MODEL=gemini-3.6-flash
# GEMINI_VIDEO_TIMEOUT=300

# --- Apify API (optional): fetch fresh scrapes without the web console -------
# Personal token from https://console.apify.com/account/integrations
# APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
# APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
# APIFY_RESULTS_LIMIT=100      # default cap per fetch (protects the $5 free tier)
# APIFY_SYNC_TIMEOUT=240       # server-side wait cap (Apify hard max ~300s)

# --- Reference history (self-audit comparison basis) --------------------------
# Every niche run saves a new timestamped snapshot here instead of overwriting
# one file; the "② Audit your posts" tab lets you pick which one to use.
# REFERENCE_HISTORY_DIR=data/reference_history
# REFERENCE_HISTORY_KEEP=3

# --- Self-audit history --------------------------------------------------------
# Every completed self-audit run saves a new timestamped snapshot here so it
# can be reopened for free later, instead of re-spending an Apify/Gemini call.
# AUDIT_HISTORY_DIR=data/audit_history
# AUDIT_HISTORY_KEEP=10
